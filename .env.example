# Copy to .env next to docker-compose.prod.yml and fill in. Never commit .env.

# -- Postgres --
POSTGRES_USER=
POSTGRES_DB=
# Goes into a connection URL: use only letters and digits, e.g. the output of `openssl rand -hex 32`
POSTGRES_PASSWORD=

# -- Cloudflare Tunnel --
# Zero Trust → Networks → Tunnels → Create a tunnel (Cloudflared) → copy the token from the install command.
# Then add a public hostname: yourdomain.com → HTTP → api:8080
TUNNEL_TOKEN=

# -- Moderation classifier --
# CPU threads for llama.cpp; leave at least one core for Postgres and the API.
LLM_THREADS=2
