{
    "name": "Burn-Before-Reading DevContainer",
    "dockerComposeFile": "docker-compose.yml",
    "service": "api",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "tamasfe.even-better-toml",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg"
            ],
            "settings": {
                "go.toolsManagement.checkForUpdates": "local",
                "go.useLanguageServer": true,
                "go.formatTool": "gofmt",
                "go.lintTool": "golint",
                "go.docsTool": "gogetdoc",
                "go.gotoSymbol.includeImports": true,
                "go.autocompleteUnimportedPackages": true,
                "sqltools.connections": [
                    {
                        "name": "PostgreSQL",
                        "driver": "PostgreSQL",
                        "previewLimit": 50,
                        "server": "db",
                        "port": 5432,
                        "database": "mydatabase",
                        "username": "myuser",
                        "password": "mypassword"
                    }
                ],
                "gopls": {
                    "ui.completion.usePlaceholders": true
                }
            }
        
        }
    },
    "forwardPorts": [],
    "postCreateCommand": "go mod download && go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.18.3 && apt-get update && apt-get install -y postgresql-client"
}